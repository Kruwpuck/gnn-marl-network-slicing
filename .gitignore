# Python and Environments
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
# produced by `pip install -e .`
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDEs and Tools
.vscode/
.idea/
.claude/

# Temporary files and artifacts
compass_artifact_*.md
.DS_Store
desktop.ini

# Local mirror of docs/journey/ — contains plaintext SSH credentials, never commit.
# Anchored to the repository root on purpose. Windows sets core.ignorecase=true, so an
# unanchored JOURNEY/ also matched docs/journey/ and silently swallowed files 08-11: they
# never appeared in git status and never entered the repo. The leading slash keeps the rule
# armed for a root-level mirror without reaching the tracked docs/journey/ series.
/JOURNEY/

# Training artifacts (generalized: applies inside results/, results/v2_scalarized/,
# results/v3_*/ archives, etc. — not just the live results/logs/ directory)
results/checkpoints/
results/**/logs/stdout/
results/**/logs/_pre_fix_backup/
results/**/*.pt
results/**/*.log

# Local launcher scripts (machine-specific, not portable)
run_*.bat
smoke_*.log

# Generated per-run config variants (reproducible from configs/experiment_config.yaml
# + scripts/run_wave.py, not hand-authored — regenerate rather than commit)
configs/generated/

# LaTeX build
paper/build/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.pdf
# template zip (sumber, tak perlu di-track)
*.zip

# Loop eskalasi — log mentah besar; ledger + handoff + research TETAP di-commit
runs/*/events.jsonl
runs/*/transcripts/

# Smoke and pilot rehearsals — bulk per-episode data whose only job was to prove the harness
# runs before the real wave. The reports they produced are committed (ATTENTION_smoke.md,
# RLIABLE_V6SMOKE.md, ZEROSHOT_v6_pilot.md); the raw rows behind them are not, matching how
# the earlier smoke runs were already handled.
results/eval_v6smoke/
results/eval_zeroshot_v6_pilot/
results/logs/*v6smoke*
